;"Generated from room-states.yaml. Do not edit; no gameplay side effects."
<ROUTINE WOH-UPDATE-STATE ()
 <SETG WOH-STATE 0>
 <COND
  (<EQUAL? ,HERE ,ARAGAIN-FALLS>
   <COND
    (<NOT ,RAINBOW-FLAG> <SETG WOH-STATE 1>)
    (,RAINBOW-FLAG <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,ATLANTIS-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,BAT-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,CANYON-BOTTOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,CANYON-VIEW>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,CELLAR>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,CHASM-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,CLEARING>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,CLIFF-MIDDLE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,COLD-PASSAGE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DAM-BASE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DAM-ROOM>
   <COND
    (<AND <NOT ,GATE-FLAG> ,GATES-OPEN <NOT <AND ,GATES-OPEN ,LOW-TIDE>>> <SETG WOH-STATE 1>)
    (<AND <NOT ,GATE-FLAG> <NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN ,LOW-TIDE>>> <SETG WOH-STATE 2>)
    (<AND <NOT ,GATE-FLAG> ,GATES-OPEN ,LOW-TIDE> <SETG WOH-STATE 3>)
    (<AND <NOT ,GATE-FLAG> ,LOW-TIDE <NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN>>> <SETG WOH-STATE 4>)
    (<AND ,GATE-FLAG ,GATES-OPEN ,LOW-TIDE> <SETG WOH-STATE 5>)
    (<AND ,GATE-FLAG ,GATES-OPEN <NOT <AND ,GATES-OPEN ,LOW-TIDE>>> <SETG WOH-STATE 6>)
    (<AND ,GATE-FLAG ,LOW-TIDE <NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN>>> <SETG WOH-STATE 7>)
    (<AND ,GATE-FLAG <NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN ,LOW-TIDE>>> <SETG WOH-STATE 8>)
   >)
  (<EQUAL? ,HERE ,DAMP-CAVE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DEAD-END-1>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DEAD-END-2>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DEAD-END-3>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DEAD-END-4>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DEAD-END-5>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,DEEP-CANYON>
   <COND
    (<AND <NOT ,LOW-TIDE> ,GATES-OPEN> <SETG WOH-STATE 1>)
    (<AND <NOT ,GATES-OPEN> ,LOW-TIDE> <SETG WOH-STATE 2>)
    (<NOT <OR <AND <NOT ,GATES-OPEN> ,LOW-TIDE> <AND <NOT ,LOW-TIDE> ,GATES-OPEN>>> <SETG WOH-STATE 3>)
   >)
  (<EQUAL? ,HERE ,DOME-ROOM>
   <COND
    (,DOME-FLAG <SETG WOH-STATE 1>)
    (<NOT ,DOME-FLAG> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,EAST-OF-CHASM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,EAST-OF-HOUSE>
   <COND
    (<NOT <FSET? ,KITCHEN-WINDOW ,OPENBIT>> <SETG WOH-STATE 1>)
    (<FSET? ,KITCHEN-WINDOW ,OPENBIT> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,EGYPT-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,END-OF-RAINBOW>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,ENGRAVINGS-CAVE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,ENTRANCE-TO-HADES>
   <COND
    (<NOT <AND <NOT ,DEAD> <NOT ,LLD-FLAG>>> <SETG WOH-STATE 1>)
    (<AND <NOT ,DEAD> <NOT ,LLD-FLAG>> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,EW-PASSAGE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,FOREST-1>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,FOREST-2>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,FOREST-3>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,GALLERY>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,GAS-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,GRATING-CLEARING>
   <COND
    (<AND ,GRATE-REVEALED <NOT <FSET? ,GRATE ,OPENBIT>>> <SETG WOH-STATE 1>)
    (<NOT <OR <FSET? ,GRATE ,OPENBIT> ,GRATE-REVEALED>> <SETG WOH-STATE 2>)
    (<FSET? ,GRATE ,OPENBIT> <SETG WOH-STATE 3>)
   >)
  (<EQUAL? ,HERE ,IN-STREAM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,KITCHEN>
   <COND
    (<NOT <FSET? ,KITCHEN-WINDOW ,OPENBIT>> <SETG WOH-STATE 1>)
    (<FSET? ,KITCHEN-WINDOW ,OPENBIT> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,LADDER-BOTTOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,LADDER-TOP>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,LAND-OF-LIVING-DEAD>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,LOUD-ROOM>
   <COND
    (<OR <AND <NOT ,GATES-OPEN> ,LOW-TIDE> ,LOUD-FLAG> <SETG WOH-STATE 1>)
    (<NOT <OR <AND <NOT ,GATES-OPEN> ,LOW-TIDE> ,LOUD-FLAG>> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,LOWER-SHAFT>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-1>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-10>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-11>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-12>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-13>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-14>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-15>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-2>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-3>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-4>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-5>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-6>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-7>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-8>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MAZE-9>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MINE-1>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MINE-2>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MINE-3>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MINE-4>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MINE-ENTRANCE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,MIRROR-ROOM-1>
   <COND
    (,MIRROR-MUNG <SETG WOH-STATE 1>)
    (<NOT ,MIRROR-MUNG> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,MIRROR-ROOM-2>
   <COND
    (,MIRROR-MUNG <SETG WOH-STATE 1>)
    (<NOT ,MIRROR-MUNG> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,MOUNTAINS>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,NARROW-PASSAGE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,NORTH-OF-HOUSE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,NORTH-TEMPLE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,NS-PASSAGE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,ON-RAINBOW>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,PATH>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,RESERVOIR>
   <COND
    (,LOW-TIDE <SETG WOH-STATE 1>)
    (<NOT ,LOW-TIDE> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,RESERVOIR-NORTH>
   <COND
    (<AND ,GATES-OPEN <NOT <AND ,GATES-OPEN ,LOW-TIDE>>> <SETG WOH-STATE 1>)
    (<AND ,GATES-OPEN ,LOW-TIDE> <SETG WOH-STATE 2>)
    (<AND ,LOW-TIDE <NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN>>> <SETG WOH-STATE 3>)
    (<NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN ,LOW-TIDE>> <SETG WOH-STATE 4>)
   >)
  (<EQUAL? ,HERE ,RESERVOIR-SOUTH>
   <COND
    (<AND ,GATES-OPEN <NOT <AND ,GATES-OPEN ,LOW-TIDE>>> <SETG WOH-STATE 1>)
    (<NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN ,LOW-TIDE>> <SETG WOH-STATE 2>)
    (<AND ,LOW-TIDE <NOT <OR <AND ,GATES-OPEN ,LOW-TIDE> ,GATES-OPEN>>> <SETG WOH-STATE 3>)
    (<AND ,GATES-OPEN ,LOW-TIDE> <SETG WOH-STATE 4>)
   >)
  (<EQUAL? ,HERE ,RIVER-1>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,RIVER-2>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,RIVER-3>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,RIVER-4>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,RIVER-5>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SANDY-BEACH>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SHAFT-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SHORE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SLIDE-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SMALL-CAVE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SMELLY-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SOUTH-OF-HOUSE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,SQUEEKY-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,STONE-BARROW>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,STRANGE-PASSAGE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,STREAM-VIEW>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,STUDIO>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,TIMBER-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,TINY-CAVE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,TORCH-ROOM>
   <COND
    (,DOME-FLAG <SETG WOH-STATE 1>)
    (<NOT ,DOME-FLAG> <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,TREASURE-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,TROLL-ROOM>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,TWISTING-PASSAGE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,WEST-OF-HOUSE>
   <COND
    (<NOT ,WON-FLAG> <SETG WOH-STATE 1>)
    (,WON-FLAG <SETG WOH-STATE 2>)
   >)
  (<EQUAL? ,HERE ,WHITE-CLIFFS-NORTH>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,WHITE-CLIFFS-SOUTH>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
  (<EQUAL? ,HERE ,WINDING-PASSAGE>
   <COND
    (T <SETG WOH-STATE 1>)
   >)
 >
 <RTRUE>>

;"Only normal command readers use this wrapper; YES?/FINISH keep native READ."
<ROUTINE WOH-READ ()
 <WOH-UPDATE-STATE>
 <READ ,P-INBUF ,P-LEXV>>
